<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape><solid android:color="#206B7A90" /><corners android:radius="8dp" /></shape>
    </item>
    <item android:id="@android:id/progress">
        <clip>
            <shape>
                <gradient android:startColor="#4F91EE" android:endColor="#89C2FF" android:angle="0" />
                <corners android:radius="8dp" />
            </shape>
        </clip>
    </item>
</layer-list>
