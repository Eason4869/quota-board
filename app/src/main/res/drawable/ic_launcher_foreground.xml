<?xml version="1.0" encoding="utf-8"?>
<!--
  额度台图标：指针式刻度盘。
  270° 等宽圆环（缺口朝正上方）+ 一根指向缺口的指针，纯线条、无填充色块。
  几何落在自适应图标安全区内：外缘半径 27.5 < 33（占 66dp 安全区的 83%），
  圆头端帽让它在 24px 下仍能分辨出「环 + 针」。
  环与指针同宽 6.0，改线宽只需动这一个数（两端圆头半径 = 线宽一半）。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- 圆环：自右上(315°)顺时针 270° 至左上(225°)，缺口 90° 朝上 -->
    <path
        android:pathData="M71.324,36.676 A24.5,24.5 0 1 1 36.676,36.676"
        android:strokeColor="#33383F"
        android:strokeWidth="6.0"
        android:strokeLineCap="round" />

    <!-- 指针：自圆心指向缺口，用主色橙，全图唯一一处彩色 -->
    <path
        android:pathData="M54,54 L64.607,43.393"
        android:strokeColor="#FF6900"
        android:strokeWidth="6.0"
        android:strokeLineCap="round" />
</vector>
