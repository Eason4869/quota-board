<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
    android:orientation="vertical" android:paddingVertical="2dp" android:paddingHorizontal="8dp"
    android:layout_marginVertical="2dp" android:background="@drawable/widget_badge">
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center_vertical">
        <TextView android:id="@+id/widget_period_label" android:layout_width="0dp" android:layout_weight="0.5"
            android:layout_height="match_parent" android:textSize="11sp" android:textColor="#6B7A90" android:gravity="center_vertical"
            android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end"
            android:autoSizeTextType="uniform" android:autoSizeMinTextSize="8sp" android:autoSizeMaxTextSize="11sp" android:autoSizeStepGranularity="1sp" />
        <TextView android:id="@+id/widget_period_value" android:layout_width="0dp" android:layout_weight="0.5"
            android:layout_height="match_parent" android:textSize="24sp" android:textStyle="bold" android:fontFamily="sans-serif-medium" android:textColor="#152033" android:gravity="end|center_vertical"
            android:includeFontPadding="false" android:maxLines="1"
            android:autoSizeTextType="uniform" android:autoSizeMinTextSize="8sp" android:autoSizeMaxTextSize="24sp" android:autoSizeStepGranularity="1sp" />
    </LinearLayout>
    <ProgressBar android:id="@+id/widget_period_progress" style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent" android:layout_height="3dp" android:minHeight="3dp" android:maxHeight="3dp"
        android:progressDrawable="@drawable/widget_progress" android:indeterminate="false" android:progress="75" android:max="100" />
    <TextView android:id="@+id/widget_period_reset" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="2dp" android:textSize="9sp" android:textColor="#6B7A90" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end"
        android:autoSizeTextType="uniform" android:autoSizeMinTextSize="7sp" android:autoSizeMaxTextSize="9sp" android:autoSizeStepGranularity="1sp" />
</LinearLayout>
