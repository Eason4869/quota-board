<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_balance_group" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:paddingTop="2dp">
    <TextView android:id="@+id/widget_detail" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="@string/label_balance" android:textSize="11sp" android:textColor="#6B7A90"
        android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" />
    <TextView android:id="@+id/widget_value" android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:gravity="center_vertical" android:text="—"
        android:textSize="40sp" android:textStyle="bold" android:textColor="#152033"
        android:fontFamily="sans-serif-medium" android:includeFontPadding="false" android:maxLines="1"
        android:autoSizeTextType="uniform" android:autoSizeMinTextSize="14sp"
        android:autoSizeMaxTextSize="40sp" android:autoSizeStepGranularity="1sp" />
</LinearLayout>
