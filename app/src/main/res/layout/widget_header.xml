<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="22dp" android:gravity="center_vertical">
    <ImageView android:id="@+id/widget_logo" android:layout_width="18dp" android:layout_height="18dp"
        android:src="@drawable/logo_openai" android:scaleType="fitCenter" android:contentDescription="@null" />
    <TextView android:id="@+id/widget_title" android:layout_width="0dp" android:layout_weight="1"
        android:layout_height="match_parent" android:layout_marginStart="6dp" android:gravity="center_vertical"
        android:text="@string/app_name" android:textSize="13sp" android:textStyle="bold" android:textColor="#152033"
        android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end"
        android:autoSizeTextType="uniform" android:autoSizeMinTextSize="9sp" android:autoSizeMaxTextSize="13sp" android:autoSizeStepGranularity="1sp" />
    <TextView android:id="@+id/widget_cards" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginEnd="4dp" android:paddingHorizontal="6dp" android:paddingVertical="2dp"
        android:background="@drawable/widget_badge" android:textColor="#397FD0" android:textSize="9sp"
        android:includeFontPadding="false" android:maxLines="1" android:visibility="gone" />
    <ImageButton android:id="@+id/widget_edit" android:layout_width="24dp" android:layout_height="match_parent"
        android:src="@drawable/widget_edit" android:background="@android:color/transparent"
        android:contentDescription="@string/widget_edit" />
</LinearLayout>
