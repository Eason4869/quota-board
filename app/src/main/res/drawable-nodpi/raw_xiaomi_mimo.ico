<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0" />
    <script>
      // 与 BANNER_STORAGE_KEY（announce_banner_dismissed）保持一致；首帧前写入，避免关闭态 Banner 闪入
      (function () {
        try {
          if (localStorage.getItem('announce_banner_dismissed')) {
            document.documentElement.setAttribute('data-banner-dismissed', '1')
          }
        } catch (e) {}
      })()
    </script>
    <style>
      html[data-banner-dismissed='1'] [data-announce-banner] {
        display: none !important;
      }
    </style>
    
